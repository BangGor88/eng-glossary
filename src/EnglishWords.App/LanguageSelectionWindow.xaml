<Window x:Class="EnglishWords.App.LanguageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose words"
        Width="520"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
    <StackPanel Margin="36" VerticalAlignment="Center">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="LITTLE BY LITTLE" />
        <TextBlock Margin="0,8,0,6" FontSize="28" FontWeight="Bold" Text="What shall we learn today?" TextWrapping="Wrap" />
        <TextBlock Margin="0,0,0,24" FontSize="15" Foreground="{StaticResource MutedBrush}" Text="Choose the language for today's word cards." />
        <Button Margin="0,0,0,10" Padding="18,14" HorizontalContentAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" Click="EnglishButton_Click">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="Bold" Foreground="White" Text="English words" />
                <TextBlock Margin="0,4,0,0" Foreground="White" Text="Learn six new English words" />
            </StackPanel>
        </Button>
        <Button Margin="0,0,0,10" Padding="18,14" HorizontalContentAlignment="Left" Background="#DFEAE4" Foreground="{StaticResource AccentBrush}" Click="SwedishButton_Click">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="Svenska ord" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Lär dig sex nya svenska ord" />
            </StackPanel>
        </Button>
        <Button Padding="18,14" HorizontalContentAlignment="Left" Background="#E3E9F0" Foreground="{StaticResource InkBrush}" Click="MixedButton_Click">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="Bold" Text="Mixed practice" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Alternate English and Swedish words" />
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
