<Window x:Class="EnglishWords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="English Words"
        Width="1100"
        Height="820"
        MinWidth="800"
        MinHeight="680"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="LITTLE BY LITTLE" />
                <TextBlock Margin="0,3,0,0" FontSize="28" FontWeight="Bold" Text="Six words for today" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Margin="32,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,12,0" Background="#DFEAE4" Foreground="{StaticResource AccentBrush}" Content="Change language" Command="{Binding ChangeLanguageCommand}" />
                <Button Margin="0,0,12,0" Background="#DFEAE4" Foreground="{StaticResource AccentBrush}" Content="Scorecard" Command="{Binding OpenScorecardCommand}" />
                <Border Background="#DFEAE4" CornerRadius="4" Padding="12,8">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="TODAY'S BEST" />
                        <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding BestScore, StringFormat={}{0}/6}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsCardsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Tap a card to read it" />
                    <Button Grid.Column="1" Margin="20,0,12,0" Padding="12,7" Background="#DFEAE4" Foreground="{StaticResource AccentBrush}" Content="New set" Command="{Binding NewSetCommand}" ToolTip="Finish the quiz with at least 3 correct answers to unlock another set." />
                    <Border Grid.Column="2" Padding="12,7" Background="#E4EBE8" CornerRadius="4">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding ReadCardCount, StringFormat={}{0} of 6 read}" />
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LessonWords}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{StaticResource CardBrush}" BorderBrush="#CFD9D3" BorderThickness="1" Command="{Binding DataContext.FlipCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Turn this word card over">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder" MinHeight="190" Padding="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                                <DataTrigger Binding="{Binding IsRead}" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="#E4F0EA" /></DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <StackPanel x:Name="CardFront" VerticalAlignment="Center">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="{Binding LanguageLabel}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding CardStatus}" />
                                            <TextBlock Margin="0,18,0,18" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Word.Word}" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding ReadLabel}" />
                                        </StackPanel>
                                        <StackPanel x:Name="CardBack" Visibility="Collapsed">
                                            <TextBlock Margin="0,0,0,6" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="{Binding LanguageLabel}" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Word.PartOfSpeech}" />
                                                <TextBlock FontSize="19" FontWeight="Bold" Text="{Binding Word.Word}" />
                                            </DockPanel>
                                            <TextBlock Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" Text="{Binding Word.Definition}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" Visibility="{Binding HasDictionarySource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Hyperlink NavigateUri="{Binding DictionarySourceUri}" RequestNavigate="DictionarySource_RequestNavigate">Definition: Wiktionary (CC BY-SA 4.0)</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,8,0,0" FontSize="12" FontStyle="Italic" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding Word.Example}" />
                                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding Word.Pronunciation}" />
                                            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding MasteryLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                    <Setter TargetName="CardFront" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CardBack" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsQuizPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Match the word" />
                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Text="{Binding QuestionNumber, StringFormat=Question {0} of 6}" />
                </DockPanel>
                <ProgressBar Grid.Row="0" Height="4" Margin="0,34,0,0" Maximum="6" Value="{Binding QuestionNumber, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#D8E0DC" />
                <Border Grid.Row="1" Width="680" MaxWidth="900" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource CardBrush}" BorderBrush="#D9E1DC" BorderThickness="1" CornerRadius="5">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding DetailLabel}" />
                        <TextBlock Margin="0,10,0,4" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Text="{Binding CurrentQuestion.Word}" />
                        <TextBlock Margin="0,0,0,22" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}" Text="{Binding QuestionPrompt}" />
                        <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,9" Padding="15,12" HorizontalContentAlignment="Left" Background="#F2F5F3" BorderBrush="#D9E1DC" BorderThickness="1" Command="{Binding DataContext.SelectAnswerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#F2F5F3" />
                                                <Setter Property="BorderBrush" Value="#D9E1DC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#C9E4D8" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding AnswerFeedback}" TextWrapping="Wrap" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="White" Content="Next question" Command="{Binding ContinueCommand}" Visibility="{Binding IsAnswerSubmitted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding QuizScore, StringFormat=Score: {0} of 6}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsResultsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="600" MaxWidth="900" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource CardBrush}" BorderBrush="#D9E1DC" BorderThickness="1" CornerRadius="5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="TODAY'S PRACTICE" />
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Text="{Binding QuizScore, StringFormat={}{0} of 6 right}" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource MutedBrush}" Text="{Binding AchievementMessage}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource AccentBrush}" Text="Five correct in a row masters a word." />
                        <Button Margin="0,24,0,0" Padding="22,12" Background="{StaticResource AccentBrush}" Foreground="White" Content="Finish today's practice" Command="{Binding FinishCommand}" Visibility="{Binding IsPracticeComplete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,12,0,0" Padding="22,12" Background="#DFEAE4" Foreground="{StaticResource AccentBrush}" Content="Learn a new set" Command="{Binding NewSetCommand}" Visibility="{Binding IsPracticeComplete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,24,0,0" Padding="22,12" Background="#E7EEE9" Foreground="{StaticResource InkBrush}" Content="Try the quiz again" Command="{Binding RetryQuizCommand}" Visibility="{Binding NeedsRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsScorecardPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Background="#DFEAE4" Foreground="{StaticResource AccentBrush}" Content="Back to practice" Command="{Binding ReturnFromScorecardCommand}" />
                    <StackPanel>
                        <TextBlock FontSize="23" FontWeight="Bold" Text="Your word scorecard" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="Words you have practiced and how often you got them right" />
                    </StackPanel>
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                    <Border Margin="0,0,10,0" Padding="16" Background="#DFEAE4" CornerRadius="4">
                        <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="WORDS LEARNED" /><TextBlock Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Text="{Binding MasteredWordCount}" /></StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" Padding="16" Background="#F1E8D8" CornerRadius="4">
                        <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="CORRECT ANSWERS" /><TextBlock Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Text="{Binding TotalCorrectAnswers}" /></StackPanel>
                    </Border>
                    <Border Padding="16" Background="#E3E9F0" CornerRadius="4">
                        <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="WORDS PRACTICED" /><TextBlock Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Text="{Binding ScorecardWords.Count}" /></StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="8,0,8,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="WORD" />
                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="MEANING" />
                        <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="GOT RIGHT" />
                        <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="MASTERY" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScorecardWords}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,1" Padding="9,11" Background="{StaticResource CardBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Word}" /><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding PartOfSpeech}" /></StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Definition}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding TimesCorrect}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{Binding MasteryLabel}" /><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding LastSeen, StringFormat=Last seen {0:MMM d}}" /></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}" Text="No words practiced yet. Finish a quiz to start your scorecard." Visibility="{Binding HasNoScorecardWords, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12,10" Background="#E4EBE8" CornerRadius="4">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding StatusMessage}" />
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,6" Background="{StaticResource AccentBrush}" Foreground="White" Content="Retry" Command="{Binding RetryCommand}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#8C4235" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.RowSpan="3" Panel.ZIndex="100" Background="#990E2727" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="360" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource CardBrush}" BorderBrush="#CFD9D3" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#D8E0DC" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Please wait..." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>